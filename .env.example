# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Native Google Sign-In (Google Cloud OAuth clients). Without them the app
# falls back to the browser OAuth flow.
# Optional overrides; defaults are hardcoded in src/auth/supabaseAuth.client.ts.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Maps: use two different keys and restrict them in Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_CERT_SHA1=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# OpenAI requests should go through the Supabase Edge Function.
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# Development-only overrides (ignored in release builds); production uses Firebase
# Remote Config `clases` / `sesiones` (both false by default).
EXPO_PUBLIC_LOCAL_CLASSES=false
EXPO_PUBLIC_FORCE_CLASES=false
EXPO_PUBLIC_LOCAL_SESSIONS=false
EXPO_PUBLIC_FORCE_SESIONES=false

# Web portal used for session checkout (/api/portal/appointment-checkout).
EXPO_PUBLIC_PORTAL_URL=https://vibes.gurudevelopers.dev

# Teacher management lives in the web portal; the in-app editors stay hidden unless true.
EXPO_PUBLIC_APP_TEACHER_MANAGEMENT=false
